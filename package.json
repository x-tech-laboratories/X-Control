{
  "name": "x-control",
  "version": "0.1.0",
  "private": true,
  "description": "Remote access and control of your devices: phones, desktops and servers, over KDE Connect and more",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "X_CONTROL_CONFIG=${X_CONTROL_CONFIG:-config.example.json} X_CONTROL_PASSWORD_HASH_FILE=${X_CONTROL_PASSWORD_HASH_FILE:-password.hash} node --watch src/server/main.ts",
    "dev:web": "vite",
    "dev:phone": "node scripts/sample_phone.ts",
    "dev": "X_CONTROL_USER_DATA=${X_CONTROL_USER_DATA:-dev-data/desktop} electron-vite dev",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && electron-vite build",
    "build:android": "tsc -b && vite build --mode android && cap sync android",
    "start": "NODE_ENV=production node src/server/main.ts",
    "hash-password": "node src/server/hash_password.ts",
    "start:desktop": "electron-vite preview",
    "typecheck": "tsc -b",
    "db:generate": "for config in src/shared/*/drizzle.config.ts; do drizzle-kit generate --config \"$config\" && x-libs-bundle-migrations \"$(dirname \"$config\")/migrations\" || exit 1; done",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "oxlint"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.3",
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.2",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@modelcontextprotocol/server": "^2.4.0",
    "@peculiar/x509": "^3.1.0",
    "@x-tech-laboratories/halon": "^0.33.0",
    "@x-tech-laboratories/x-libs": "^0.79.0",
    "bonjour-service": "^1.4.4",
    "dbus-next": "^0.10.2",
    "fastify": "^5.12.8",
    "mqtt": "^5.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "ws": "~8.23.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/cli": "^8.6.3",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "aedes": "^1.2.0",
    "drizzle-kit": "^1.0.0-rc.6",
    "electron": "^45.5.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "usocket": true
  },
  "optionalDependencies": {
    "usocket": "^1.1.0"
  },
  "overrides": {
    "usocket": "$usocket"
  }
}
